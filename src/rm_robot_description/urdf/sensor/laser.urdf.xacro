<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
<xacro:include filename="$(find rm_robot_description)/urdf/common_inertia.urdf.xacro" />
   <!-- 激光雷达的描述 传入参数xyz,用于指定激光雷达在机器人基座中的位置 -->
   <xacro:macro name="laser_xacro" params="xyz">
         <!-- 激光雷达杆laser_cylinder -->
        <link name="laser_cylinder_link" >
            <!-- 部件外观描述 -->
            <!-- visual属于虚拟可视化部件,不参与运动学计算 -->
            <visual>
                <!-- 沿自身几何中心的偏差 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 radius 半径/m length 高度/m-->
                    <cylinder radius="0.01" length="0.10" />
                </geometry>
                <!-- 材质颜色透明度 -->
                <material name="green_laser_cylinder" >
                    <color rgba="0.0 0.5 0.0 1.0" />    
                </material>
            </visual>
            <!-- collision 碰撞检测 ,参与运动学计算 -->
            <collision>
                <!-- 沿自身几何中心的偏差 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 radius 半径/m length 高度/m-->
                    <cylinder radius="0.01" length="0.10" />
                </geometry>
            </collision>
            <!-- 惯性矩阵 -->
            <xacro:cylinder_inertia m="0.02" r="0.01" h="0.10" />
        </link> 

        <!-- 激光雷达laser -->
        <link name="laser_link" >
            <!-- 部件外观描述 -->
            <!-- visual属于虚拟可视化部件,不参与运动学计算 -->
            <visual>
                <!-- 沿自身几何中心的偏差 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 radius 半径/m length 高度/m-->
                    <cylinder radius="0.02" length="0.02" />
                </geometry>
                <!-- 材质颜色透明度 -->
                <material name="green_laser" >
                    <color rgba="0.0 0.5 0.0 1.0" />    
                </material>
            </visual>
            <!-- collision 碰撞检测 ,参与运动学计算 -->
            <collision>
                <!-- 沿自身几何中心的偏差 -->
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 radius 半径/m length 高度/m-->
                    <cylinder radius="0.02" length="0.02" />
                </geometry>
                <!-- 惯性矩阵 -->
                <xacro:cylinder_inertia m="0.02" r="0.02" h="0.02" />
            </collision>
        </link> 

        <!-- laser相对于laser_cylinder的固定关节 -->
        <joint name="laser_to_laser_cylinder_joint" type="fixed" >
            <parent link="laser_cylinder_link" />
            <child link="laser_link" />
            <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0" />
        </joint>

        <!-- laser_cylinder相对于base_link的固定关节 -->
        <joint name="laser_cylinder_to_base_link_joint" type="fixed" >
            <parent link="base_link" />
            <child link="laser_cylinder_link" />
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0" />
        </joint>

    </xacro:macro>   
</robot>
